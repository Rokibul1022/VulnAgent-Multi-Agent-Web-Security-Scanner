# VulnAgent backend environment (copy to .env and fill in)
# Comma-separated Groq API keys; triage uses them round-robin.
GROQ_API_KEYS=
# Groq model used for triage.
GROQ_MODEL=openai/gpt-oss-120b
# OWASP ZAP container image (full mode only).
ZAP_DOCKER_IMAGE=zaproxy/zap-stable
# nuclei template directory.
NUCLEI_TEMPLATES_PATH=~/nuclei-templates
